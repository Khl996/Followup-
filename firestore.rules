rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdminEmail() {
      return request.auth.token.email != null && request.auth.token.email.lower() == 'khalid.a.kh990@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users collection
    // Any authenticated supervisor can read user profiles (to display names of creators/closers)
    // Admin can create/update/delete any user document
    // First-time signed-in normal user may only create their own document with strictly validated safe fields
    // Users cannot update their own role or active status (admin-only updates)
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.id == userId &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.active == true &&
          (isBootstrapAdminEmail() ? request.resource.data.role in ['admin', 'supervisor'] : request.resource.data.role == 'supervisor')
        )
      );

      allow update, delete: if isAdmin();
    }

    // 2. Workers collection (technicians, cleaners, etc.)
    // Read: All authenticated supervisors
    // Write: Only admins
    match /workers/{workerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(workerId);
    }

    // 3. Locations collection
    // Read: All authenticated supervisors
    // Write: Only admins
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(locationId);
    }

    // 4. Categories collection
    // Read: All authenticated supervisors
    // Write: Only admins
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(categoryId);
    }

    // 5. Observations collection
    // Transition validation helpers using affectedKeys()
    function isClosingValid() {
      return (resource.data.status == 'OPEN' || resource.data.status == 'PAUSED')
        && request.resource.data.status == 'CLOSED'
        && request.resource.data.closedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedBy', 'closedByName', 'closedAt']);
    }

    function isPausingValid() {
      return resource.data.status == 'OPEN'
        && request.resource.data.status == 'PAUSED'
        && request.resource.data.pausedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pausedBy', 'pausedByName', 'pausedAt', 'pauseReason', 'reviewDate']);
    }

    function isReopeningValid() {
      return resource.data.status == 'PAUSED'
        && request.resource.data.status == 'OPEN'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /observations/{observationId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(observationId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'OPEN'
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1000;

      // Closed observations cannot be reopened or modified by normal supervisors
      // Only admins have broader maintenance access
      allow update: if isSignedIn() && (
        isAdmin() ||
        isClosingValid() ||
        isPausingValid() ||
        isReopeningValid()
      );

      allow delete: if isAdmin();
    }
  }
}
